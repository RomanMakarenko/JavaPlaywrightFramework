<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="TestSuite" parallel="classes" thread-count="3">
    <test name="SmokeTest">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.FrameworkBasicsDataProviderTest"/>
            <class name="tests.ContinueUIValidationsTest"/>
            <class name="tests.MoreUIValidationsTest"/>
        </classes>
    </test>
</suite>